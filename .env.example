# ==============================================================================
# Promo Finder Environment Configuration
# ==============================================================================

# GROQ API Key (Ultra-fast inference: llama-3.3-70b-versatile, llama-3.1-8b-instant)
GROQ_API_KEY=

# Anthropic Claude API Key (e.g. claude-3-7-sonnet-20250219, claude-3-5-sonnet-20241022)
ANTHROPIC_API_KEY=

# OpenAI API Key (e.g. gpt-4o, o3-mini)
OPENAI_API_KEY=

# Google Gemini API Key (e.g. gemini-2.5-pro, gemini-2.5-flash)
GEMINI_API_KEY=

# Default Model & Provider (optional override)
# MODEL=llama-3.3-70b-versatile
# LLM_PROVIDER=groq

